
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out pull request code'
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.3.0.6276:sonar \
                          -Dsonar.projectKey=Anuradha122118_DemoWebApp \
                          -Dsonar.organization=anuradha122118 \
                          -Dsonar.host.url=https://sonarcloud.io
                    '''
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    trivy fs --config "" \
                      --scanners vuln,secret,misconfig \
                      --severity HIGH,CRITICAL .
                '''
            }
        }

        stage('PR Validation Complete') {
            steps {
                echo 'PR validation: Maven, SonarQube and Trivy stages completed'
            }
        }
    }

    post {
        always {
            echo 'PR validation pipeline finished'
        }
    }
}
