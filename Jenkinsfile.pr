
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out pull request code'
                checkout scm
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarCloud') {
                    sh '''
                        mvn sonar:sonar \
                          -Dsonar.projectKey=Anuradha122118_DemoWebApp \
                          -Dsonar.organization=anuradha122118 \
                          -Dsonar.host.url=https://sonarcloud.io
                    '''
                }
            }
        }

        stage('PR Validation Complete') {
            steps {
                echo 'Build and SonarQube analysis completed'
            }
        }
    }

    post {
        always {
            echo 'PR validation pipeline finished'
        }
    }
}
